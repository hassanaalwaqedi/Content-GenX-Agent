# ============================================================================
# Content Intelligence Platform — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# ============================================================================

# ---- API Keys ---------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key_here
GROQ_API_KEY=                            # Groq API key for AI enrichment

# ---- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///content_intelligence.db
SQLITE_DB_PATH=content_intelligence.db

# ---- YouTube Ingestion -----------------------------------------------------
YOUTUBE_MAX_RESULTS_PER_QUERY=50
YOUTUBE_MAX_PAGES=3
YOUTUBE_RETRY_ATTEMPTS=3
YOUTUBE_RETRY_DELAY_SECONDS=2.0

# ---- Reddit Ingestion ------------------------------------------------------
# Get credentials at https://www.reddit.com/prefs/apps (create "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=GenXContentIntel/1.0
REDDIT_MAX_POSTS_PER_QUERY=100

# ---- Scoring Weights -------------------------------------------------------
SCORE_WEIGHT_VIEWS=0.4
SCORE_WEIGHT_ENGAGEMENT=0.35
SCORE_WEIGHT_RECENCY=0.25

# ---- Filter Thresholds -----------------------------------------------------
FILTER_MIN_VIEWS=1000
FILTER_MIN_ENGAGEMENT_RATE=0.02

# ---- Scheduler --------------------------------------------------------------
PIPELINE_SCHEDULE_TIME=06:00

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# ---- API Server -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---- Security ---------------------------------------------------------------
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Shared secret for /pipeline/run endpoint (leave empty to disable auth)
PIPELINE_API_KEY=
