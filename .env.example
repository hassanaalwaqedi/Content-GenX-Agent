# ============================================================================
# Content Intelligence Platform — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# ============================================================================

# ---- API Keys ---------------------------------------------------------------
YOUTUBE_API_KEY=
GROQ_API_KEY=                  # Groq API key for AI enrichment

# ---- Database ---------------------------------------------------------------
DATABASE_URL=
SQLITE_DB_PATH=

# ---- YouTube Ingestion -----------------------------------------------------
YOUTUBE_MAX_RESULTS_PER_QUERY=
YOUTUBE_MAX_PAGES=
YOUTUBE_RETRY_ATTEMPTS=
YOUTUBE_RETRY_DELAY_SECONDS=

# ---- Apify Platform (for Instagram + TikTok) --------------------------------
APIFY_API_TOKEN=

# ---- TikTok Ingestion (uses Apify clockworks/tiktok-scraper) ----------------
TIKTOK_ENABLED=
APIFY_TIKTOK_ACTOR_ID=
TIKTOK_REQUEST_DELAY=
TIKTOK_MAX_RESULTS=
TIKTOK_REQUEST_TIMEOUT=

# ---- Instagram Ingestion (uses Apify Instagram Scraper) ---------------------
INSTAGRAM_ENABLED=
APIFY_INSTAGRAM_ACTOR_ID=
INSTAGRAM_REQUEST_DELAY=
INSTAGRAM_MAX_RESULTS=

# ---- Reddit Ingestion (via Apify) -----------------------------------------
# Requires APIFY_API_TOKEN above
REDDIT_ENABLED=
APIFY_REDDIT_ACTOR_ID=
REDDIT_REQUEST_DELAY=
REDDIT_MAX_RESULTS=

# ---- Scoring Weights -------------------------------------------------------
SCORE_WEIGHT_VIEWS=
SCORE_WEIGHT_ENGAGEMENT=
SCORE_WEIGHT_RECENCY=

# ---- Filter Thresholds -----------------------------------------------------
FILTER_MIN_VIEWS=
FILTER_MIN_ENGAGEMENT_RATE=

# ---- Scheduler --------------------------------------------------------------
PIPELINE_SCHEDULE_TIME=

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=

# ---- API Server -------------------------------------------------------------
API_HOST=
API_PORT=

# ---- Security ---------------------------------------------------------------
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=
# Shared secret for /pipeline/run endpoint (leave empty to disable auth)
PIPELINE_API_KEY=

# ---- Authentication ----------------------------------------------------------
GENX_ADMIN_USERNAME=
GENX_ADMIN_PASSWORD=
GENX_AUTH_SECRET=
