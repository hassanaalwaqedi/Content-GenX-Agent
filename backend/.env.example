# ============================================================================
# Content Intelligence Platform — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# ============================================================================

# ---- API Keys ---------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key_here
GROQ_API_KEY=                            # Groq API key for AI enrichment

# ---- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///content_intelligence.db
SQLITE_DB_PATH=content_intelligence.db

# ---- YouTube Ingestion -----------------------------------------------------
YOUTUBE_MAX_RESULTS_PER_QUERY=50
YOUTUBE_MAX_PAGES=3
YOUTUBE_RETRY_ATTEMPTS=3
YOUTUBE_RETRY_DELAY_SECONDS=2.0

# ---- Apify Platform (for Reddit, TikTok, Instagram) -------------------------
# Get your token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# ---- TikTok Ingestion (uses Apify clockworks/tiktok-scraper) ----------------
# Requires APIFY_API_TOKEN above
TIKTOK_ENABLED=false
APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper
TIKTOK_REQUEST_DELAY=2.0
TIKTOK_MAX_RESULTS=30
TIKTOK_REQUEST_TIMEOUT=30

# ---- Instagram Ingestion (uses Apify Instagram Scraper) ---------------------
# Requires APIFY_API_TOKEN above
INSTAGRAM_ENABLED=false
APIFY_INSTAGRAM_ACTOR_ID=shu8hvrXbJbY3Eb9W
INSTAGRAM_REQUEST_DELAY=3.0
INSTAGRAM_MAX_RESULTS=30

# ---- Reddit Ingestion (uses Apify Reddit Scraper) ---------------------------
# Requires APIFY_API_TOKEN above
REDDIT_ENABLED=true
APIFY_REDDIT_ACTOR_ID=automation-lab~reddit-scraper
REDDIT_REQUEST_DELAY=2.0
REDDIT_MAX_RESULTS=30

# ---- Velocity Scoring Weights -----------------------------------------------
VELOCITY_WEIGHT_VIEWS=0.3
VELOCITY_WEIGHT_ENGAGEMENT=0.35
VELOCITY_WEIGHT_RECENCY=0.2
VELOCITY_WEIGHT_SHARES=0.15

# ---- Scoring Weights -------------------------------------------------------
SCORE_WEIGHT_VIEWS=0.4
SCORE_WEIGHT_ENGAGEMENT=0.35
SCORE_WEIGHT_RECENCY=0.25

# ---- Filter Thresholds -----------------------------------------------------
FILTER_MIN_VIEWS=1000
FILTER_MIN_ENGAGEMENT_RATE=0.02

# ---- Scheduler --------------------------------------------------------------
PIPELINE_SCHEDULE_TIME=06:00

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# Set false for human-readable local logs.
LOG_JSON=true

# ---- Operations -------------------------------------------------------------
# Relative backup paths are created next to SQLITE_DB_PATH.
DATABASE_BACKUP_DIR=backups
DATABASE_BACKUP_RETENTION_DAYS=14

# ---- API Server -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---- Security ---------------------------------------------------------------
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional service-to-service secret for pipeline triggers. Authenticated UI users can still run scans.
PIPELINE_API_KEY=
# Global rolling request limit per client IP.
API_RATE_LIMIT_REQUESTS=180
API_RATE_LIMIT_WINDOW_SECONDS=60
